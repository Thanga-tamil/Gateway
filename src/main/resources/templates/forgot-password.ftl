<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <title>Forget-pasword</title>
    <link
      href="https://fonts.googleapis.com/css?family=Asap:400,500i,600,700&amp;display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <table width="650" style="width: 100%;background-color: #EEF2F9;">
      <tbody>
        <tr>
          <td>
            <table
              width="650"
              style="width: 650px;margin: 0px auto;padding: 30px 15px;"
            >
              <tbody>
                <tr style="text-align: center;">
                  <td>
                    <div>
                      <img
                        src="${IMAGE_BASE_URL}/logo.png"
                        style="
width: 300px;
margin: 40px 0;
"
                      />
                    </div>
                  </td>
                </tr>
                <tr style="text-align: center;">
                  <td>
                    <table
                      style="width: 100%;margin: 0px auto;background-color: #ffffff;border-radius: 15px;"
                    >
                      <tbody>
                        <tr
                          style="text-align: center;background: url(${IMAGE_BASE_URL}/bg.png);;background-size: cover;background-size: contain;background-repeat: no-repeat;background-position: top center;"
                        >
                          <td style="padding: 0px;">
                            <div>
                              <img
                                src="${IMAGE_BASE_URL}/mail-ic.png"
                                alt=""
                                style="
padding-top: 20px;
"
                              />
                            </div>
                          </td>
                        </tr>
                        <tr style="text-align: center;">
                          <td>
                            <div>
                              <p
                                style="
            text-align: center;
            color:#000000;
            font-weight: 500;
            font-size: 26px;
            font-family: 'Asap', sans-serif;
            margin: 10px 0px;
            "
                              >
                                Forgot your Password
                              </p>
                            </div>
                          </td>
                        </tr>

                        <tr style="text-align: center;">
                          <td>
                            <div>
                              <p
                                style="
            font-size: 16px;
            line-height: 157.19%;
            font-family: 'Asap', sans-serif;
            color: #7D7D7D;
            margin: 0;
            text-align: center;
            padding: 20px 50px;
            "
                              >
                                Please click the button below to reset your password.
                              </p>
                            </div>
                          </td>
                        </tr>
                        <tr style="text-align: center;">
                          <td>
                              <a href="${RESET_PASSWORD}">
                            <button
                              style="
        cursor: pointer;
        background: #5E59DA;
        box-shadow: 0px 4px 11px rgba(0, 0, 0, 0.08);
        border-radius: 5px;
        padding: 14px 50px;
        color:#ffffff;
        border:none;
        outline:none;
        font-size: 16px;
        margin: 10px 0px 20px 0px;
        font-family: 'Asap', sans-serif;
        "
                            >
                              RESET PASSWORD
                            </button>
                          </a>
                          </td>
                        </tr>
                        <tr style="text-align: center;">
                          <td>
                            <div>
                              <p
                                style="font-size: 16px;line-height: 157.19%;font-family: 'Asap', sans-serif;color: #B9B9B9;margin: 5px 0px;text-align: center;font-style: normal;font-weight: normal;padding-bottom: 30px;"
                              >
                                If you receive this in error, simply ignore this
                                email and do not click the button
                              </p>
                            </div>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </td>
                </tr>

                <tr style="text-align: center;">
                  <td
                    style="
padding: 20px 0px;
"
                  >
                    <div>
                      <p
                        style="font-size: 16px;line-height: 157.19%;font-family: 'Asap', sans-serif;color: #7D7D7D;margin: 5px 0px;text-align: center;font-style: normal;font-weight: normal;"
                      >
                        @2020 Mirrorfly contus - All Rights Reserved
                      </p>
                      <p
                        style="font-size: 16px;line-height: 157.19%;font-family: 'Asap', sans-serif;color: #7D7D7D;margin: 5px 0px;text-align: center;font-style: normal;font-weight: normal;"
                      >
                        <a href="" style="color: #7D7D7D;text-decoration: none;"
                          >www.contus.in</a
                        >
                      </p>
                    </div>
                  </td>
                </tr>
              </tbody>
            </table>
          </td>
        </tr>
      </tbody>
    </table>
  </body>
</html>
